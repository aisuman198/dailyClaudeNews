# Daily Claude News 環境変数テンプレート
# このファイルをコピーして `.env` にリネームし、必要に応じて値を設定してください。
# `.env` は .gitignore でコミット対象外。

# === Claude CLI 呼び出し設定 ===
# 主モデル（省略時は claude-sonnet-4-6）
CLAUDE_MODEL=claude-sonnet-4-6
# フォールバックモデル（主モデル過負荷時）
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
# レビュー担当モデル（推敲フェーズ。高品質を優先するなら Sonnet）
REVIEWER_MODEL=claude-sonnet-4-6
# レビューフェーズを有効化するか（true/false）
REVIEW_ENABLED=true
# CLI 実行タイムアウト（ミリ秒）。summarize / review の各呼び出しに適用。
# Claude API 混雑時の遅延を吸収するため 30 分を既定
CLAUDE_TIMEOUT_MS=1800000
# パイプライン開始前の認証プリフライト（claude を1回叩いて認証確認）のタイムアウト（ミリ秒）。
AUTH_CHECK_TIMEOUT_MS=120000

# === ニュースソース ===
# Anthropic は RSS を提供していないため sitemap.xml から /news/ /research/ /engineering/
# 配下の URL を抽出する方式。lastmod が直近 ANTHROPIC_LOOKBACK_DAYS 以内のものを対象とする。
ANTHROPIC_SITEMAP=https://www.anthropic.com/sitemap.xml
ANTHROPIC_LOOKBACK_DAYS=7
ANTHROPIC_MAX_ITEMS=15
# Hacker News トップストーリー API
HN_TOP_STORIES_API=https://hacker-news.firebaseio.com/v0/topstories.json
HN_ITEM_API=https://hacker-news.firebaseio.com/v0/item
# HN topstories の上位何件をキーワードフィルタの対象にするか（500 まで）
HN_MAX_ITEMS=100
# HN でフィルタするキーワード（カンマ区切り）
HN_KEYWORDS=Claude,Anthropic,AI,LLM,GPT,Gemini

# === 出力設定 ===
# まとめの出力先（プロジェクトルートからの相対パス）
OUTPUT_DIR=docs/daily

# === 優先フィルタ ===
# このキーワード群に該当する記事を優先的に採用（カンマ区切り、単語境界一致、大文字小文字無視）
PRIORITY_KEYWORDS=Anthropic,Claude,Codex
# 優先記事がこの件数を超える場合は補充しない（=これ以下なら他記事で補充）
PRIORITY_MIN_NO_PAD=5
# 補充時の目標総件数
PRIORITY_PAD_TARGET=10

# === 重複排除設定 ===
# 同run内のタイトル類似度しきい値（0.0〜1.0、デフォルト 0.85）
DEDUP_TITLE_SIMILARITY=0.85
# 過去何日分を継続話題として参照するか（デフォルト 14）
HISTORY_RETENTION_DAYS=14
# state ファイルのパス（プロジェクトルートからの相対）
HISTORY_STATE_PATH=state/seen.json
# 継続話題のうち、bodyText のハッシュが前回観測時と同一のもの (新情報なし) を
# 出力から除外する。false にすると従来通り継続話題も全件 summarize に渡す。
RECURRING_DROP_UNCHANGED=true
# 固有名詞誤訳などの注意リストの保存先
CAUTIONS_STATE_PATH=state/cautions.json

# === Git 設定 ===
# コミット時の Author 名・メール（省略時は git config のグローバル値）
GIT_AUTHOR_NAME=Daily Claude News Bot
GIT_AUTHOR_EMAIL=your-email@example.com

# === エラー通知 ===
# Issue を起票する先のリポジトリ（owner/name）
ERROR_ISSUE_REPO=aisuman198/dailyClaudeNews
# macOS 通知センターを使う（true/false）
MACOS_NOTIFICATION=true

# === Discord 通知 ===
# エラー通知と記事共有は「別チャンネル」に投稿するため Webhook URL を 2 本設定する。
# （Discord のチャンネル設定 → 連携サービス → ウェブフック から発行）
# Webhook URL は秘密情報。.env に置き、コミットしないこと。
# Discord への投稿全体の ON/OFF（true/false）
DISCORD_NOTIFICATION=true
# 定期実行が失敗したとき「エラーが出た旨 + GitHub issue のリンク」を投稿するチャンネル
DISCORD_ERROR_WEBHOOK_URL=
# 実行に成功したとき「公開した記事の URL」を投稿するチャンネル（エラーとは別チャンネル）
DISCORD_NEWS_WEBHOOK_URL=
# Webhook 送信のタイムアウト（ms）
DISCORD_TIMEOUT_MS=15000

# === ログ ===
# 詳細ログを出力する（true/false）
VERBOSE=false

# === デプロイ検証（verify-deploy フェーズ）===
# git push したあと GitHub Pages 上に本日のページが公開されたかを確認するか
VERIFY_DEPLOYMENT_ENABLED=true
# Pages のベース URL（末尾スラッシュなし）
PAGES_BASE_URL=https://aisuman198.github.io/dailyClaudeNews
# push 後、最初の確認までの待機時間（ms）。Jekyll のビルド完了を見越して 60s 既定
VERIFY_DEPLOYMENT_INITIAL_DELAY_MS=60000
# ポーリング間隔（ms）。デフォルト 30s
VERIFY_DEPLOYMENT_INTERVAL_MS=30000
# 最大待機時間（ms）。これを超えても公開を確認できない場合は失敗扱い。デフォルト 10 分
VERIFY_DEPLOYMENT_TIMEOUT_MS=600000
