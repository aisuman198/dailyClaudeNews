# Daily Claude News 環境変数テンプレート
# このファイルをコピーして `.env` にリネームし、必要に応じて値を設定してください。
# `.env` は .gitignore でコミット対象外。

# === Claude CLI 呼び出し設定 ===
# 主モデル（省略時は claude-sonnet-4-6）
CLAUDE_MODEL=claude-sonnet-4-6
# フォールバックモデル（主モデル過負荷時）
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
# CLI 実行タイムアウト（ミリ秒）
CLAUDE_TIMEOUT_MS=300000

# === ニュースソース ===
# Anthropic 公式ブログ RSS
ANTHROPIC_BLOG_RSS=https://www.anthropic.com/news/rss.xml
# Hacker News トップストーリー API
HN_TOP_STORIES_API=https://hacker-news.firebaseio.com/v0/topstories.json
HN_ITEM_API=https://hacker-news.firebaseio.com/v0/item
# HN から取得する最大記事数
HN_MAX_ITEMS=30
# HN でフィルタするキーワード（カンマ区切り）
HN_KEYWORDS=Claude,Anthropic,AI,LLM,GPT,Gemini

# === 出力設定 ===
# まとめの出力先（プロジェクトルートからの相対パス）
OUTPUT_DIR=docs/daily

# === Git 設定 ===
# コミット時の Author 名・メール（省略時は git config のグローバル値）
GIT_AUTHOR_NAME=Daily Claude News Bot
GIT_AUTHOR_EMAIL=oreha.kobashu@gmail.com

# === エラー通知 ===
# Issue を起票する先のリポジトリ（owner/name）
ERROR_ISSUE_REPO=aisuman198/dailyClaudeNews
# macOS 通知センターを使う（true/false）
MACOS_NOTIFICATION=true

# === ログ ===
# 詳細ログを出力する（true/false）
VERBOSE=false
