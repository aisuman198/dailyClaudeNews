# Daily Claude News 環境変数テンプレート
# このファイルをコピーして `.env` にリネームし、必要に応じて値を設定してください。
# `.env` は .gitignore でコミット対象外。

# === Claude CLI 呼び出し設定 ===
# 主モデル（省略時は claude-sonnet-4-6）
CLAUDE_MODEL=claude-sonnet-4-6
# フォールバックモデル（主モデル過負荷時）
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001
# レビュー担当モデル（推敲フェーズ。高品質を優先するなら Sonnet）
REVIEWER_MODEL=claude-sonnet-4-6
# レビューフェーズを有効化するか（true/false）
REVIEW_ENABLED=true
# CLI 実行タイムアウト（ミリ秒）。summarize / review の各呼び出しに適用。余裕を持って 20 分
CLAUDE_TIMEOUT_MS=1200000

# === ニュースソース ===
# Anthropic は RSS を提供していないため sitemap.xml から /news/ /research/ /engineering/
# 配下の URL を抽出する方式。lastmod が直近 ANTHROPIC_LOOKBACK_DAYS 以内のものを対象とする。
ANTHROPIC_SITEMAP=https://www.anthropic.com/sitemap.xml
ANTHROPIC_LOOKBACK_DAYS=7
ANTHROPIC_MAX_ITEMS=15
# Hacker News トップストーリー API
HN_TOP_STORIES_API=https://hacker-news.firebaseio.com/v0/topstories.json
HN_ITEM_API=https://hacker-news.firebaseio.com/v0/item
# HN topstories の上位何件をキーワードフィルタの対象にするか（500 まで）
HN_MAX_ITEMS=100
# HN でフィルタするキーワード（カンマ区切り）
HN_KEYWORDS=Claude,Anthropic,AI,LLM,GPT,Gemini

# === 出力設定 ===
# まとめの出力先（プロジェクトルートからの相対パス）
OUTPUT_DIR=docs/daily

# === 重複排除設定 ===
# 同run内のタイトル類似度しきい値（0.0〜1.0、デフォルト 0.85）
DEDUP_TITLE_SIMILARITY=0.85
# 過去何日分を継続話題として参照するか（デフォルト 14）
HISTORY_RETENTION_DAYS=14
# state ファイルのパス（プロジェクトルートからの相対）
HISTORY_STATE_PATH=state/seen.json
# 固有名詞誤訳などの注意リストの保存先
CAUTIONS_STATE_PATH=state/cautions.json

# === Git 設定 ===
# コミット時の Author 名・メール（省略時は git config のグローバル値）
GIT_AUTHOR_NAME=Daily Claude News Bot
GIT_AUTHOR_EMAIL=oreha.kobashu@gmail.com

# === エラー通知 ===
# Issue を起票する先のリポジトリ（owner/name）
ERROR_ISSUE_REPO=aisuman198/dailyClaudeNews
# macOS 通知センターを使う（true/false）
MACOS_NOTIFICATION=true

# === ログ ===
# 詳細ログを出力する（true/false）
VERBOSE=false
