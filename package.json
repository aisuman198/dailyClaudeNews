{
  "name": "daily-claude-news",
  "version": "0.1.0",
  "description": "Mac launchd で毎朝起動し、Claude Code CLI ヘッドレスモードで AI 業界ニュースをまとめて GitHub にコミットする",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "sync:redact-fixture": "cp \"$HOME/.claude/scripts/redact.cjs\" fixtures/claude-scripts/redact.cjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
