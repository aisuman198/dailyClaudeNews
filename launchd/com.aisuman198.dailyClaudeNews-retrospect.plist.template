<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  このファイルはテンプレートです。プレースホルダ {{HOME}} / {{PROJECT_ROOT}} は
  scripts/install-launchd.sh が実行時に各環境の絶対パスへ置換し、
  ~/Library/LaunchAgents/ にレンダリング結果を配置します。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aisuman198.dailyClaudeNews-retrospect</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PROJECT_ROOT}}/scripts/retrospect.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/dailyClaudeNews/launchd.retrospect.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/dailyClaudeNews/launchd.retrospect.err.log</string>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_ROOT}}</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
